# Any OpenAI-compatible endpoint. Hosted: set the key. Local (Ollama, LM Studio): no key.
CASCA_BASE_URL=https://router.huggingface.co/v1
CASCA_MODEL=google/gemma-4-31b-it
CASCA_API_KEY=
# CASCA_BASE_URL=http://localhost:11434/v1
# CASCA_MODEL=qwen3-vl:8b
CASCA_MAX_STEPS=20
CASCA_MONITOR=1
CASCA_SCREENSHOT_MAX_WIDTH=1280
CASCA_STEP_DELAY=0.5
